{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "optimized build for this computer",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "build with sanitizers and all library checks",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows",
      "displayName": "Windows program, built on macOS or Linux with mingw-w64",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "${sourceDir}/windows_cross.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core",
      "displayName": "numerical code and its tests, without the window",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CORE_ONLY": "ON" }
    },
    {
      "name": "core-x86",
      "displayName": "numerical code for x86-64 on an Apple Silicon Mac; its tests run under Rosetta and include the AVX2 loops",
      "binaryDir": "${sourceDir}/build/core-x86",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CORE_ONLY": "ON", "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "jobs": 0 },
    { "name": "debug", "configurePreset": "debug", "jobs": 0 },
    { "name": "windows", "configurePreset": "windows", "jobs": 0 },
    { "name": "core", "configurePreset": "core", "jobs": 0 },
    { "name": "core-x86", "configurePreset": "core-x86", "jobs": 0,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "core-x86", "configurePreset": "core-x86", "output": { "outputOnFailure": true },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "environment": { "TEST_AVX2": "1" } }
  ]
}
